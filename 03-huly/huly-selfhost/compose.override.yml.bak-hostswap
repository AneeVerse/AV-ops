x-huly-hosts: &huly-hosts
  extra_hosts:
    - "huly.aneeverse.com:host-gateway"

services:
  nginx:
    <<: *huly-hosts
  account:
    image: ${ACCOUNT_IMAGE}
    <<: *huly-hosts
  front:
    <<: *huly-hosts
    image: ${FRONT_IMAGE}
  workspace:
    <<: *huly-hosts
  transactor:
    <<: *huly-hosts
  fulltext:
    <<: *huly-hosts
  stats:
    <<: *huly-hosts
  collaborator:
    <<: *huly-hosts
  kvs:
    <<: *huly-hosts
    deploy:
      resources:
        limits:
          memory: 256M
  rekoni:
    <<: *huly-hosts
  elastic:
    environment:
      - ES_JAVA_OPTS=-Xms256m -Xmx256m
    deploy:
      resources:
        limits:
          memory: 512M
  cockroach:
    command: start-single-node --accept-sql-without-tls --cache=256MiB --max-sql-memory=256MiB
    deploy:
      resources:
        limits:
          memory: 768M
  redpanda:
    deploy:
      resources:
        limits:
          memory: 512M
  minio:
    deploy:
      resources:
        limits:
          memory: 256M
