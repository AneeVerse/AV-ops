x-huly-hosts: &huly-hosts
  extra_hosts:
    - "app.aneeverse.com:host-gateway"

services:
  nginx:
    <<: *huly-hosts
  account:
    image: ${ACCOUNT_IMAGE}
    <<: *huly-hosts
    environment:
      - MAIL_URL=http://mail:8097
  front:
    <<: *huly-hosts
    image: ${FRONT_IMAGE}
  workspace:
    <<: *huly-hosts
  transactor:
    <<: *huly-hosts
    environment:
      - MAIL_URL=http://mail:8097
  fulltext:
    <<: *huly-hosts
  stats:
    <<: *huly-hosts
  collaborator:
    <<: *huly-hosts
  kvs:
    <<: *huly-hosts
    deploy:
      resources:
        limits:
          memory: 256M
  rekoni:
    <<: *huly-hosts
  elastic:
    environment:
      - ES_JAVA_OPTS=-Xms256m -Xmx256m
    deploy:
      resources:
        limits:
          memory: 512M
  cockroach:
    command: start-single-node --accept-sql-without-tls --cache=256MiB --max-sql-memory=256MiB
    deploy:
      resources:
        limits:
          memory: 768M
  redpanda:
    deploy:
      resources:
        limits:
          memory: 512M
  minio:
    deploy:
      resources:
        limits:
          memory: 256M
  mail:
    image: hardcoreeng/mail:${HULY_VERSION}
    environment:
      - PORT=8097
      - SOURCE=${MAIL_SOURCE}
      - SMTP_HOST=smtp.resend.com
      - SMTP_PORT=587
      - SMTP_USERNAME=resend
      - SMTP_PASSWORD=${RESEND_API_KEY}
      - SMTP_TLS_MODE=upgrade
    restart: unless-stopped
    networks:
      - huly_net