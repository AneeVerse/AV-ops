44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Assigned", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00004", "reference_owner": null, "content": "Administrator assigned Sarah Connor: Assignment for CRM Deal CRM-DEAL-2026-00004", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a0ui4mmlhi", "creation": "2026-04-25 14:44:06.424758", "modified": "2026-04-25 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Assigned", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00005", "reference_owner": null, "content": "Administrator assigned Sarah Connor: Assignment for CRM Deal CRM-DEAL-2026-00005", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a0ukpibr2o", "creation": "2026-04-25 14:44:06.424758", "modified": "2026-04-25 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Shared", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00005", "reference_owner": null, "content": "Administrator shared this document with Sarah Connor", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a0uoeir65l", "creation": "2026-05-08 14:44:06.424758", "modified": "2026-05-08 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Shared", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00004", "reference_owner": null, "content": "Administrator shared this document with Sarah Connor", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a0v36pj8d6", "creation": "2026-05-10 14:44:06.424758", "modified": "2026-05-10 14:44:06.424758", "modified_by": "john.demo@example.com", "owner": "john.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Assigned", "comment_email": "john.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00006", "reference_owner": null, "content": "Administrator assigned John Parker: Assignment for CRM Deal CRM-DEAL-2026-00006", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a0vbb71app", "creation": "2026-05-10 14:44:06.424758", "modified": "2026-05-10 14:44:06.424758", "modified_by": "john.demo@example.com", "owner": "john.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Shared", "comment_email": "john.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00006", "reference_owner": null, "content": "Administrator shared this document with John Parker", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a106t69gul", "creation": "2026-05-14 14:44:06.424758", "modified": "2026-05-14 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Assigned", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00007", "reference_owner": null, "content": "Administrator assigned Sarah Connor: Assignment for CRM Deal CRM-DEAL-2026-00007", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10cblm9le", "creation": "2026-05-17 14:44:06.424758", "modified": "2026-05-17 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Comment", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": "Sarah Connor", "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00005", "reference_owner": null, "content": "<p>Deal closed — Jack signed the contract this morning. Final value $175k annual. Onboarding is scheduled for next Monday. Handoff notes sent to the customer success team. Great result for the quarter!</p>", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10m86b5lq", "creation": "2026-05-11 14:44:06.424758", "modified": "2026-05-11 14:44:06.424758", "modified_by": "john.demo@example.com", "owner": "john.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Comment", "comment_email": "john.demo@example.com", "subject": null, "comment_by": "John Parker", "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00006", "reference_owner": null, "content": "<p>Karen's team went with a competitor — they had deeper BI integrations that we currently don't support. Not a pricing issue. Flagged to product team for roadmap consideration. Karen asked us to follow up in 6 months.</p>", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10n0m85sv", "creation": "2026-05-09 14:44:06.424758", "modified": "2026-05-09 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Comment", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": "Sarah Connor", "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00004", "reference_owner": null, "content": "<p>Qualification call completed with Iris and her co-founder. Small but fast-moving team of 8 engineers. Main concerns are API depth and self-serve onboarding. Sending over the developer docs and scheduling a technical deep-dive.</p>", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10n3jtb1v", "creation": "2026-05-16 14:44:06.424758", "modified": "2026-05-16 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Comment", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": "Sarah Connor", "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00001", "reference_owner": null, "content": "<p>Live demo went well — Alice's product team joined and had great questions about workflow automation and bulk import. They want a custom sandbox environment to evaluate with their own data before signing. Following up to arrange access.</p>", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10oa69ik0", "creation": "2026-05-14 14:44:06.424758", "modified": "2026-05-14 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Comment", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": "Sarah Connor", "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00002", "reference_owner": null, "content": "<p>David reviewed the proposal with his co-founder. They're happy with the pricing but want a 3-month pilot before committing to annual. Checking with management on whether we can offer a pilot discount.</p>", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10odkncph", "creation": "2026-05-12 14:44:06.424758", "modified": "2026-05-12 14:44:06.424758", "modified_by": "john.demo@example.com", "owner": "john.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Comment", "comment_email": "john.demo@example.com", "subject": null, "comment_by": "John Parker", "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00003", "reference_owner": null, "content": "<p>Negotiation call with Henry went long but productive. He’s pushing for a 15% discount on the annual plan citing budget constraints. Legal team is now reviewing the contract — decision expected by end of week.</p>", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10p6omsca", "creation": "2026-05-07 14:44:06.424758", "modified": "2026-05-07 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Comment", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": "Sarah Connor", "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00007", "reference_owner": null, "content": "<p>Budget was cut for the rest of the year — Leo was very apologetic and said the product was exactly what they needed. Re-added to nurture sequence for Q4. Good candidate for a comeback deal.</p>", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "a10r8pet3b", "creation": "2026-05-14 14:44:06.424758", "modified": "2026-05-14 14:44:06.424758", "modified_by": "sarah.demo@example.com", "owner": "sarah.demo@example.com", "docstatus": 0, "idx": 0, "comment_type": "Shared", "comment_email": "sarah.demo@example.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Deal", "reference_name": "CRM-DEAL-2026-00007", "reference_owner": null, "content": "Administrator shared this document with Sarah Connor", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}, {"name": "i4ac6n8dbe", "creation": "2026-06-27 19:15:49.892281", "modified": "2026-06-27 19:15:49.892281", "modified_by": "anees@aneeverse.com", "owner": "anees@aneeverse.com", "docstatus": 0, "idx": 0, "comment_type": "Assigned", "comment_email": "anees@aneeverse.com", "subject": null, "comment_by": null, "published": 0, "seen": 0, "reference_doctype": "CRM Lead", "reference_name": "CRM-LEAD-2026-01429", "reference_owner": null, "content": "Ahmad Anees self assigned this task: Assignment for CRM Lead CRM-LEAD-2026-01429", "ip_address": null, "_user_tags": null, "_comments": null, "_assign": null, "_liked_by": null}]