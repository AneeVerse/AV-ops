# Public app URL after deployment
APP_URL=https://chat.aneeverse.com

# Local OpenClaw Gateway. Keep loopback; do not expose Gateway directly.
OPENCLAW_GATEWAY_WS=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token

# Phase 1 login. Use a strong password and random session secret.
CHAT_USERNAME=ahmad
CHAT_PASSWORD=change-this-password
SESSION_SECRET=replace-with-random-32-plus-char-secret

# Optional cookie domain for production. Usually leave blank unless needed.
COOKIE_DOMAIN=

# Server-side WebSocket Origin header accepted by current OpenClaw config
OPENCLAW_GATEWAY_ORIGIN=https://bot.aneeverse.com
