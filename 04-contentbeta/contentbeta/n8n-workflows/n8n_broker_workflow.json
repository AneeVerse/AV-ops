    {
      "parameters": {
        "jsCode": "const prediction = $input.first().json;\nif (prediction.status === 'failed' || prediction.status === 'canceled') {\n  throw new Error('Prediction ' + prediction.status + ': ' + (prediction.error || 'unknown error'));\n}\nconst replicateImageUrl = Array.isArray(prediction.output) ? prediction.output[0] : prediction.output;\nif (!replicateImageUrl) throw new Error('No output URL from Replicate: ' + JSON.stringify(prediction));\nreturn [{ json: { replicateImageUrl } }];"
      },
      "id": "extract-url",
      "name": "Extract URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6720,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.replicateImageUrl }}",
