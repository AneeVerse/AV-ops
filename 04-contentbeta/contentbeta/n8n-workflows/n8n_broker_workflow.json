    {
      "parameters": {
        "jsCode": "const prompts = $('Fetch Broker Prompts').all().map(p => p.json);\nconst brandId = ($('Webhook Broker').first().json.body && $('Webhook Broker').first().json.body.brandId) || '4d9f2a2d-1d28-41fe-a371-d35b9efaee3b';\nconst extraPrompt = ($('Webhook Broker').first().json.body?.extraPrompt || '').trim();\n\nif (!prompts.length) throw new Error('No broker prompts found');\n\nlet picked;\nlet finalPrompt;\nif (extraPrompt) {\n  const userContextPrompt = prompts.find(p => p.name === 'Common prompt for User context');\n  if (!userContextPrompt) throw new Error('No prompt named \"Common prompt for User context\" found');\n  picked = userContextPrompt;\n  finalPrompt = 'User Context: ' + extraPrompt + '. ' + picked.prompt;\n} else {\n  const otherPrompts = prompts.filter(p => p.name !== 'Common prompt for User context');\n  if (!otherPrompts.length) throw new Error('No prompts available for random selection');\n  picked = otherPrompts[Math.floor(Math.random() * otherPrompts.length)];\n  finalPrompt = picked.prompt;\n}\nconst refImages = Array.isArray(picked.reference_image_urls) ? picked.reference_image_urls.filter(Boolean) : [];\nconst storagePath = 'broker-images/' + Date.now() + '_post.png';\n\nreturn [{ json: {\n  storagePath,\n  brandId,\n  useProModel: !!extraPrompt,\n  requestBody: {\n    input: {\n      prompt: finalPrompt,\n      image_input: refImages,\n      aspect_ratio: '16:9',\n      output_format: 'png',\n      resolution: '2K',\n      safety_filter_level: 'block_only_high',\n      use_fallback_model: true\n    }\n  }\n} }];"
      },
