{
  "name": "Ad Concept Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ad-concept",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "ac-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "webhookId": "ad-concept-webhook-id"
    },
    {
      "parameters": {
        "url": "=__SUPABASE_URL__/rest/v1/brand_profiles?brand_id=eq.{{ $('Webhook').first().json.body.brandId }}&select=*,brands(name)&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "__SUPABASE_SERVICE_ROLE_KEY__"
            },
            {
              "name": "Authorization",
              "value": "Bearer __SUPABASE_SERVICE_ROLE_KEY__"
            }
          ]
        },
        "options": {}
      },
      "id": "ac-fetch-brand",
      "name": "Fetch Brand Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "url": "=__SUPABASE_URL__/rest/v1/ad_angles?id=eq.{{ $('Webhook').first().json.body.adAngleId }}&select=*,ad_angle_images(id,image_url)&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "__SUPABASE_SERVICE_ROLE_KEY__"
            },
            {
              "name": "Authorization",
              "value": "Bearer __SUPABASE_SERVICE_ROLE_KEY__"
            }
          ]
        },
        "options": {}
      },
      "id": "ac-fetch-angle",
      "name": "Fetch Angle Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const webhookBody = $('Webhook').first().json.body;\nconst brandData = $('Fetch Brand Data').first().json;\nconst angleData = $('Fetch Angle Data').first().json;\n\nconst brandName = brandData.brands?.name || 'Unknown Brand';\nconst brandStyle = brandData.style_prompt || '';\nconst logoUrl = brandData.logo_url || null;\nconst brandId = webhookBody.brandId;\nconst adAngleId = webhookBody.adAngleId;\nconst angleName = angleData.name || '';\nconst anglePrompt = angleData.prompt || '';\nconst puppeteerConfig = angleData.puppeteer_config || {};\nconst angleImages = angleData.ad_angle_images || [];\n\nif (!angleName) throw new Error('Ad angle not found.');\nif (!angleImages.length) throw new Error('No images found for this ad angle. Add images in Ad Angles first.');\nif (!anglePrompt) throw new Error('No prompt set for this ad angle. Set a generation prompt in Ad Angles settings.');\n\nconst randomImage = angleImages[Math.floor(Math.random() * angleImages.length)];\n\nconst imagePrompt = `Do not include any logos or brand marks in the image.\\n\\n${anglePrompt}\\n\\nBrand: ${brandName}\\nBrand Style:\\n${brandStyle}`;\n\nreturn [{\n  json: {\n    brandId,\n    adAngleId,\n    brandName,\n    logoUrl,\n    puppeteerConfig,\n    visualReferenceUrl: randomImage.image_url,\n    storagePath: `${brandId}/${Date.now()}_ad_concept.png`,\n    imagePrompt\n  }\n}];"
      },
      "id": "ac-build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Build Prompt').first().json.visualReferenceUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "ac-download-ref",
      "name": "Download Reference Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/edits",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer __OPENAI_API_KEY__"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-image-1.5"
            },
            {
              "name": "prompt",
              "value": "={{ $('Build Prompt').first().json.imagePrompt }}"
            },
            {
              "name": "size",
              "value": "1024x1024"
            },
            {
              "name": "n",
              "value": "1"
            },
            {
              "name": "image",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "ac-generate-image",
      "name": "Generate Ad Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const imageResponse = $('Generate Ad Image').first().json;\nconst meta = $('Build Prompt').first().json;\n\nconst b64 = imageResponse.data?.[0]?.b64_json;\nif (!b64) throw new Error('No image data: ' + JSON.stringify(imageResponse));\n\nconst binaryData = await this.helpers.prepareBinaryData(\n  Buffer.from(b64, 'base64'),\n  'ad_concept.png',\n  'image/png'\n);\n\nreturn [{\n  json: {\n    brandId: meta.brandId,\n    adAngleId: meta.adAngleId,\n    logoUrl: meta.logoUrl,\n    puppeteerConfig: meta.puppeteerConfig,\n    visualReferenceUrl: meta.visualReferenceUrl,\n    storagePath: meta.storagePath,\n    imageUrl: null\n  },\n  binary: { data: binaryData }\n}];"
      },
      "id": "ac-extract-image",
      "name": "Extract Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://upload.imagekit.io/api/v1/files/upload",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Basic __IMAGEKIT_BASIC_AUTH__"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{ 'data:' + ($binary.data.mimeType || 'image/png') + ';base64,' + $binary.data.data }}"
            },
            {
              "name": "fileName",
              "value": "={{ ($json.storagePath || $('Pick Prompt').first().json.storagePath || 'upload.png').toString().split('/').pop() }}"
            },
            {
              "name": "folder",
              "value": "/generated-posts"
            },
            {
              "name": "useUniqueFileName",
              "value": "true"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "ac-upload-storage",
      "name": "Upload to ImageKit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const meta = $('Extract Image').first().json;\nconst uploaded = $('Upload to ImageKit').first().json;\nif (!uploaded.url) throw new Error('ImageKit upload failed: ' + JSON.stringify(uploaded));\nreturn [{\n  json: {\n    imageUrl: uploaded.url,\n    visualReferenceUrl: meta.visualReferenceUrl,\n    puppeteerConfig: meta.puppeteerConfig,\n    logoUrl: meta.logoUrl,\n    brandId: meta.brandId,\n    adAngleId: meta.adAngleId\n  }\n}];"
      },
      "id": "ac-assemble",
      "name": "Assemble Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "ac-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2160,
        0
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Fetch Brand Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Brand Data": {
      "main": [
        [
          {
            "node": "Fetch Angle Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Angle Data": {
      "main": [
        [
          {
            "node": "Build Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Prompt": {
      "main": [
        [
          {
            "node": "Download Reference Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Reference Image": {
      "main": [
        [
          {
            "node": "Generate Ad Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Ad Image": {
      "main": [
        [
          {
            "node": "Extract Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Image": {
      "main": [
        [
          {
            "node": "Upload to ImageKit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to ImageKit": {
      "main": [
        [
          {
            "node": "Assemble Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assemble Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
