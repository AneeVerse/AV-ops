        "jsCode": "const r = $input.first().json;\nconst meta = $('Parse Slides').first().json;\nconst i = 0;\nconst b64 = r.data?.[0]?.b64_json;\nif (!b64) throw new Error('Slide 0: no image data: ' + JSON.stringify(r));\nconst storagePath = meta.slides[i].storagePath;\nconst imageUrl = meta.slides[i].imageUrl;\nconst binaryData = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), `slide_${i}.png`, 'image/png');\nreturn [{ json: { slideIndex: i, storagePath, imageUrl }, binary: { data: binaryData } }];"
