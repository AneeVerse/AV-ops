    {
      "parameters": {
        "jsCode": "const brand = $('Fetch Brand Data').first().json;\nconst stylePrompt = brand.style_prompt || '';\nconst webhookBody = $('Webhook').first().json.body;\nconst slides = webhookBody.slides;\nconst colors = webhookBody.colors || { primaryColor: '#1a1a2e', accentColor: '#3b82f6', textColor: '#ffffff' };\nconst brandId = webhookBody.brandId;\nconst jobId = webhookBody.jobId;\nconst logoUrl = webhookBody.logoUrl || brand.logo_url || null;\nconst ts = Date.now();\n\nlet templateSlides = [];\ntry {\n  const layoutData = $('Fetch Layout').first().json;\n  templateSlides = layoutData?.carousel_slide_prompts || [];\n} catch(e) { templateSlides = []; }\n\nconst enriched = slides.slice(0, 6).map((slide, i) => {\n  const splitPercent = slide.splitPercent || (slide.slideType === 'title' ? 65 : slide.slideType === 'cta' ? 80 : 50);\n  const imageSidePct = 100 - splitPercent;\n  const templateSlide = templateSlides.find(t => t.slide_index === i + 1);\n  const cfg = templateSlide?.puppeteer_config || null;\n\n  const brandStyle = stylePrompt.substring(0, 1500);\n  const slideContext = [slide.headline, slide.subhead, ...(slide.bullets || [])].filter(Boolean).join('. ');\n  const fallbackBgPrompt = `Cinematic, high-quality background photograph for a LinkedIn carousel slide. ${slide.visualContext || ''} The LEFT ${splitPercent}% of the frame should be relatively clean, uncluttered, and low contrast. Concentrate visual interest in the RIGHT ${imageSidePct}% of the frame. No text, no logos, no UI elements. Professional editorial photography quality. Square 1:1 format.`;\n  const baseBgPrompt = (templateSlide?.prompt && templateSlide.prompt.trim()) ? `${templateSlide.prompt}\\n\\nVisual context: ${slide.visualContext || ''}` : fallbackBgPrompt;\n  const bgPrompt = `${baseBgPrompt}\\n\\nBRAND STYLE GUIDE (use for colors, mood, visual language):\\n${brandStyle}\\n\\nSLIDE TOPIC CONTEXT (visual should reflect this, do NOT render as text):\\n${slideContext}`;\n\n  const requestBody = JSON.stringify({\n    model: 'gpt-image-2',\n    prompt: bgPrompt,\n    n: 1,\n    size: '1024x1024',\n    quality: 'medium'\n  });\n\n  const storagePath = `${brandId}/${ts}_v2_carousel_slide_${i}.png`;\n  const imageUrl = null; // set from ImageKit upload response\n\n  const puppeteerConfig = {\n    headlineSize: cfg?.headlineSize || null,\n    microcopySize: cfg?.microcopySize || null,\n    verticalAlign: cfg?.verticalAlign || null,\n    logoPosition: cfg?.logoPosition || slide.logoPos || 'bottom-left',\n    logoX: cfg?.logoX ?? null,\n    logoY: cfg?.logoY ?? null,\n    logoSize: cfg?.logoSize || 48,\n    accentColor: cfg?.accentColor || colors.accentColor,\n    primaryColor: cfg?.bgColor || colors.primaryColor,\n    textColor: cfg?.headlineColor || colors.textColor,\n    microcopyColor: cfg?.microcopyColor || null,\n    bulletSize: cfg?.bulletSize || null,\n    customFontDataUrl: cfg?.customFontDataUrl || null,\n    fontFamily: cfg?.fontFamily || null,\n    headlineFontFamily: cfg?.headlineFontFamily || null,\n    headlineCustomFontDataUrl: cfg?.headlineCustomFontDataUrl || null,\n    eyebrowFontFamily: cfg?.eyebrowFontFamily || null,\n    eyebrowCustomFontDataUrl: cfg?.eyebrowCustomFontDataUrl || null,\n    microcopyFontFamily: cfg?.microcopyFontFamily || null,\n    microcopyCustomFontDataUrl: cfg?.microcopyCustomFontDataUrl || null,\n    bulletFontFamily: cfg?.bulletFontFamily || null,\n    bulletCustomFontDataUrl: cfg?.bulletCustomFontDataUrl || null,\n    ctaFontFamily: cfg?.ctaFontFamily || null,\n    ctaCustomFontDataUrl: cfg?.ctaCustomFontDataUrl || null,\n    eyebrowColor: cfg?.eyebrowColor || null,\n    eyebrowSize: cfg?.eyebrowSize || null,\n    eyebrowUppercase: cfg?.eyebrowUppercase ?? null,\n    ctaPosition: cfg?.ctaPosition || null,\n    ctaStyle: cfg?.ctaStyle || null,\n    logoDataUrl: cfg?.logoDataUrl || null,\n    padding: cfg?.padding || 60,\n    removeBg: cfg?.removeBg || false,\n    elements: cfg?.elements || [],\n    splitPercent: cfg?.splitPercent ?? null,\n    textX: cfg?.textX ?? null,\n    textY: cfg?.textY ?? null,\n  };\n\n  return { requestBody, storagePath, imageUrl, originalSlide: { ...slide, _colors: colors, _cfg: puppeteerConfig } };\n});\n\nreturn [{ json: { slides: enriched, colors, brandId, jobId, logoUrl, timestamp: ts } }];"
      },
