[Unit]
Description=Sales n8n bridge for deterministic no-AI lead draft automation
After=network.target

[Service]
Environment=GOG_ACCOUNT=anees@aneeverse.com
Environment=GOG_KEYRING_PASSWORD=CHANGE_ME
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/root/.config
Type=simple
WorkingDirectory=/root/.openclaw/workspace
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/scripts/sales_n8n_bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
