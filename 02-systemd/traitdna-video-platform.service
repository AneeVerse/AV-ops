[Unit]
Description=TraitDNA Video Platform MVP1
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/.openclaw/workspace/projects/traitdna-video-platform
Environment=HOST=0.0.0.0
Environment=PORT=8787
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/root/.openclaw/workspace/projects/traitdna-video-platform/.service.env
ExecStart=/usr/bin/python3 -m app.web
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
