[Unit]
Description=Codex ChatGPT proxy for Cursor (gpt-5.6-sol)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/tmp/codex-proxy-src
Environment=PATH=/root/.local/bin:/tmp/codex-proxy-src/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
EnvironmentFile=/opt/codex-proxy/.env
ExecStart=/tmp/codex-proxy-src/.venv/bin/codex-proxy serve --host 127.0.0.1 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
