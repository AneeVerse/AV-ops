[Unit]
Description=Block external direct access to Hermes dashboard port 9119
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -i eth0 -p tcp --dport 9119 -j DROP 2>/dev/null || /usr/sbin/iptables -I INPUT 1 -i eth0 -p tcp --dport 9119 -j DROP'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
