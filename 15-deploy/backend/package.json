{
  "name": "my-medusa-store",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "TS_NODE_COMPILER=typescript TS_NODE_TRANSPILE_ONLY=true MEDUSA_ADMIN_DISABLE_SW=true medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "postinstall": "patch-package && node scripts/patch-upload-limit.js"
  },
  "dependencies": {
    "@devx-commerce/razorpay": "^5.0.0-beta.0",
    "@medusajs/admin-sdk": "2.12.3",
    "@medusajs/auth-google": "2.13.1",
    "@medusajs/cli": "2.12.3",
    "@medusajs/framework": "2.12.3",
    "@medusajs/medusa": "2.12.3",
    "@tsc_tech/medusa-plugin-smtp": "^0.0.3",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.9",
    "customer-registration": "^0.0.124",
    "imagekit": "^6.0.0",
    "medusa-analytics": "0.0.24",
    "medusa-contact-us": "^0.0.26",
    "medusa-customer-file-upload": "0.0.1",
    "medusa-dynamic-metadata": "0.0.7",
    "medusa-export": "^0.0.5",
    "medusa-invoice-sbl": "^0.0.11",
    "medusa-notification-provider": "^0.0.2",
    "medusa-notification-token-management": "^0.0.1",
    "medusa-plugin-dynamic-config": "^0.0.25",
    "medusa-product-helper": "0.0.73",
    "medusa-review-rating": "^0.0.37",
    "medusa-shiprocket-fulfillment-sbl": "0.0.28",
    "medusa-twilio-sms": "^2.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "order-management": "^0.0.78",
    "patch-package": "^8.0.1",
    "pdfkit": "^0.17.2",
    "stock-monitoring": "^0.0.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.12.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
