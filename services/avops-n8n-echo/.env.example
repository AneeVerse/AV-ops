# Localhost-only caller for the one approved n8n echo workflow.
# Copy to /opt/av_ops/docker/avops-n8n-echo/.env on the server. Mode 600.
# Do not commit the real secret or the real webhook path.

AVOPS_N8N_ECHO_URL=http://127.0.0.1:5678/webhook/replace-with-server-path
AVOPS_N8N_ECHO_SECRET=replace-on-server
