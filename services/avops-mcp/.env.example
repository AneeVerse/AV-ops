# Copy to .env on the server only. Never commit .env.
# HULY_READ_TOKEN is a Huly Settings API token for the AV OPS workspace.
# Create it in the Huly UI. Do not mint it from the account service secret.
HULY_READ_TOKEN=
HULY_TRANSACTOR_URL=ws://127.0.0.1:8087
AVOPS_MCP_BIND=127.0.0.1
AVOPS_MCP_PORT=8765
# Local bearer for the HTTP listener. Generate on the server. Not a Huly credential.
AVOPS_MCP_AUTH=
